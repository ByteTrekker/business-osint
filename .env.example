# Backend
BUSINESS_OSINT_DATABASE_URL=postgresql+asyncpg://osint:osint@localhost:5432/osint
BUSINESS_OSINT_DEBUG=true
BUSINESS_OSINT_DEFAULT_PLAN=free
# Pepper do hashowania PESEL — w produkcji z menedżera sekretów, NIGDY z repo.
BUSINESS_OSINT_PESEL_PEPPER=change-me

# Poświadczenia do rejestrów — puste znaczy, że źródło jest wyłączone.
# Klucz GUS BIR1 (REGON): wniosek na https://api.stat.gov.pl/Home/RegonApi
BUSINESS_OSINT_REGON_API_KEY=
# Token CEIDG v2: rejestracja na https://dane.biznes.gov.pl
BUSINESS_OSINT_CEIDG_TOKEN=
BUSINESS_OSINT_CORS_ORIGINS=["http://localhost:3000"]

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
